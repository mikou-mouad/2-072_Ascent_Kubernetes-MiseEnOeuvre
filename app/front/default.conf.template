server {
    listen 8080;
    root /usr/share/nginx/html;

    location /api/ {
        proxy_pass ${BACK_URL};
        proxy_set_header Host $host;
    }

    # Fichiers de configuration montés depuis une ConfigMap (TP 03) : jamais en cache
    location /config/ {
        add_header Cache-Control "no-store";
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        try_files $uri /index.html;
    }
}
